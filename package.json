{
  "name": "navo",
  "version": "0.1.0",
  "private": true,
  "description": "Navo: AI That Handles Onboarding. An AI onboarding agent prototype for Halden (fictional company, synthetic data).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "samples:render": "tsx scripts/render-samples.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "video:capture": "tsx scripts/video/capture.ts",
    "video:render": "tsx scripts/video/render.ts",
    "video": "npm run video:capture && npm run video:render",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "eval": "tsx scripts/eval.ts",
    "load-test": "tsx scripts/load-test.ts",
    "cost-model": "tsx scripts/cost-model.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
