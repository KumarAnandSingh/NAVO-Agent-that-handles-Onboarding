# Claude API key for the deployment (server-side only). Leave empty to run offline: every AI
# feature has a rule-based fallback. The public demo runs with no key; visitors can connect
# their own key in the app instead (see NAVO_BYOK).
ANTHROPIC_API_KEY=

# Model routing. Each task uses the smallest model that does it well, with a fallback:
#   status updates: claude-haiku-5-5 → claude-sonnet-5-5
#   Ask Navo:       claude-sonnet-5-5 → claude-opus-5-5
#   documents:      claude-opus-5-5 → claude-sonnet-5-5
# Leave these empty for the defaults. NAVO_MODEL pins every task to one model; the per-task
# settings win over it. The default chain still backs up an override.
NAVO_MODEL=
NAVO_MODEL_NARRATE=
NAVO_MODEL_ASK=
NAVO_MODEL_DOCUMENTS=

# Bring your own key: visitors may connect their own Claude key, kept in their browser tab and
# never stored or logged by the server. Set to "off" to disable.
NAVO_BYOK=

# Postgres connection string (Neon on Vercel). Leave empty locally to use the embedded PGlite database in .data/.
DATABASE_URL=

# Postgres connections per server instance (default 10).
NAVO_DB_POOL_MAX=

# Daily cap on Claude calls made with the deployment's own key.
NAVO_DAILY_LLM_CALL_LIMIT=400

# Per-visitor cap on Claude calls per day, on any key (each visitor gets their own workspace).
NAVO_WORKSPACE_DAILY_LLM_CALL_LIMIT=80

# Set to "off" to ignore ANTHROPIC_API_KEY and run offline (useful for rehearsals and recordings).
NAVO_LIVE_AI=

# Whole-answer deadline for Ask Navo before the rule-based answer is used (milliseconds).
NAVO_ASK_TIMEOUT_MS=25000
