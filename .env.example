# Claude API key (server-side only). Without it Navo runs in offline mode with scripted fallbacks.
ANTHROPIC_API_KEY=

# Claude model used by Navo (defaults to claude-opus-5-5).
NAVO_MODEL=claude-opus-5-5

# Postgres connection string (Neon on Vercel). Leave empty locally to use the embedded PGlite database in .data/.
DATABASE_URL=

# Daily cap on Claude calls per deployment (protects the hosted demo key).
NAVO_DAILY_LLM_CALL_LIMIT=400

# Per-visitor cap on Claude calls per day (each visitor gets their own workspace).
NAVO_WORKSPACE_DAILY_LLM_CALL_LIMIT=80

# Set to "off" to force offline mode even when a key is present (useful for rehearsals).
NAVO_LIVE_AI=

# Whole-answer deadline for Ask Navo before the scripted answer is used (milliseconds).
NAVO_ASK_TIMEOUT_MS=25000
